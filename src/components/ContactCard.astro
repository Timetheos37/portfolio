---
import Icon from './Icon.astro';

// Renseigne tes informations ici
const phone = "+41 77 407 53 79";
const email = "tim.sgroi@ikmail.com";
---

<div class="contact-card">
    <!-- Ligne Téléphone -->
    <div class="contact-row">
        <div class="contact-info">
            <Icon icon="phone" size="1.5rem" />
            <span>{phone}</span>
        </div>
        <button class="copy-btn" data-copy={"+41774075379"} aria-label="Copier le numéro">
            <Icon icon="copy" size="1.2rem" />
        </button>
    </div>

    <!-- Ligne Email -->
    <div class="contact-row">
        <div class="contact-info">
            <Icon icon="envelope" size="1.5rem" />
            <a href={`mailto:${email}`}>{email}</a>
        </div>
        <button class="copy-btn" data-copy={email} aria-label="Copier l'adresse email">
            <Icon icon="copy" size="1.2rem" />
        </button>
    </div>
</div>

<style>
    .contact-card {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding: 2rem;
        background: var(--gradient-subtle);
        border: 1px solid var(--gray-800);
        border-radius: 1.5rem;
        box-shadow: var(--shadow-sm);
        width: 100%;
        max-width: 450px;
    }

    .contact-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--gray-800);
    }

    .contact-row:last-child {
        padding-bottom: 0;
        border-bottom: none;
    }

    .contact-info {
        display: flex;
        align-items: center;
        gap: 1rem;
        font-size: var(--text-md);
        color: var(--gray-200);
    }

    .contact-info a {
        color: var(--gray-200);
        text-decoration: none;
        transition: color var(--theme-transition);
    }

    .contact-info a:hover {
        color: var(--accent-regular);
        text-decoration: underline;
    }

    .copy-btn {
        background: transparent;
        border: 1px solid transparent;
        color: var(--gray-400);
        cursor: pointer;
        padding: 0.5rem;
        border-radius: 0.5rem;
        transition: all var(--theme-transition);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .copy-btn:hover {
        color: var(--accent-regular);
        background: var(--gray-900);
        border: 1px solid var(--gray-800);
    }
</style>

<script>
    // Ce script s'exécute côté client (dans le navigateur) pour gérer la copie
    const copyButtons = document.querySelectorAll<HTMLButtonElement>('.copy-btn');

    copyButtons.forEach(button => {
        button.addEventListener('click', async () => {
            const textToCopy = button.getAttribute('data-copy');
            if (textToCopy) {
                try {
                    // Copie dans le presse-papier
                    await navigator.clipboard.writeText(textToCopy);
                    
                    // Effet visuel temporaire (devient violet)
                    button.style.color = 'var(--accent-regular)';
                    
                    // Retour à la normale après 1.5 secondes
                    setTimeout(() => {
                        button.style.color = ''; 
                    }, 1500);
                } catch (err) {
                    console.error('Erreur lors de la copie : ', err);
                }
            }
        });
    });
</script>