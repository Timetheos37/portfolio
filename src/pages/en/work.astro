---
import { getCollection } from 'astro:content';
import ContactCTA from '../../components/ContactCTA.astro';
import Grid from '../../components/Grid.astro';
import Portrait from '../../components/Portrait.astro';
import PortfolioPreview from '../../components/PortfolioPreview.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allWork = await getCollection('work');
const projects = allWork
	.filter((project) => !project.data.draft && project.id.startsWith('en/'))
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<BaseLayout
	title="Mes projets | Timothée Sgroi"
	description="Explorez mes derniers projets"
>
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Portrait
				title="Mes projets"
				tagline="Consultez mes derniers projets ci-dessous pour avoir une idée de mon expérience passée."
				align="start"
			/>
			<Grid variant="offset">
                {
                    projects.map((project) => (
                        <li>
                            <PortfolioPreview project={project} />
                        </li>
                    ))
                }
            </Grid>
		</main>
		<ContactCTA />
	</div>
</BaseLayout>
