---
import { Carousel } from 'webcoreui/astro';

interface Props {
    images: { src: string; alt?: string }[];
}

const { images } = Astro.props;
---

<div class="carousel-container">
    <!-- On ajoute la progress bar et le texte de statut -->
    <Carousel 
        items={images.length} 
        progress={true} 
    >
        {images.map((image) => (
            <li class="carousel-slide">
                <img 
                    src={image.src} 
                    alt={image.alt || ''} 
                    loading="lazy" 
                    class="carousel-image"
                />
            </li>
        ))}
    </Carousel>
</div>

<style>
    .carousel-container {
        width: 100%;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--gray-800);
        border-radius: 1.5rem;
        overflow: hidden; 
    }

    /* On s'assure que chaque slide prend exactement 100% de la place disponible */
    .carousel-slide {
        flex: 0 0 100%; /* Force 1 image à la fois */
        display: flex;
        justify-content: center;
        align-items: center;
        list-style-type: none; /* Retire le petit point noir par défaut des listes <li> */
        margin: 0;
        padding: 0;
    }

    .carousel-image {
        width: 100%;
        height: auto;
        max-height: 70vh;
        object-fit: contain;
        background: transparent;
    }
</style>